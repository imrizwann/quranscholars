VITE_API_URL="http://localhost:3000"
# On the Vercel frontend set VITE_API_URL=/ to use the same-origin /api rewrite.
# The upstream API hostname is configured in vercel.json, never a secret.

# Optional public CDN/R2 origin for recorded-course thumbnail object keys.
# Leave empty to show image placeholders; never put private bucket credentials here.
VITE_COURSE_MEDIA_BASE_URL=

# Course presentation: featured (small catalogue) or full (existing discovery UI).
VITE_CATALOGUE_LAYOUT=featured

# Public canonical website origin (not an API URL or secret).
VITE_PUBLIC_SITE_URL=https://www.quranscholar.in
