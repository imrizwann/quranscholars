VITE_API_URL="http://localhost:3000"
# For production use / with a same-origin /api proxy, or an HTTPS API origin.
# Paths such as /api are not base URLs: API slices already include that prefix.
# All VITE_* values are public. Unknown VITE_* variables fail release builds.

# Optional public CDN/R2 origin for recorded-course thumbnail object keys.
# Leave empty to show image placeholders; never put private bucket credentials here.
VITE_COURSE_MEDIA_BASE_URL=

# Course presentation: featured (small catalogue) or full (existing discovery UI).
VITE_CATALOGUE_LAYOUT=featured

# Public canonical website origin (not an API URL or secret).
VITE_PUBLIC_SITE_URL=https://www.quranscholar.in

# Optional HTTPS/WSS origin when real-time traffic uses a separate proxy.
# It must receive the same API session cookie. Blank uses VITE_API_URL.
VITE_REALTIME_URL=

# Experimental Custom Checkout. Standard remains the default.
VITE_PAYMENT_CHECKOUT=standard
# Enable only after account approval and test-mode acceptance. No secret values here.
VITE_CUSTOM_CHECKOUT_LIVE_ENABLED=false
# Desktop non-redirect UPI QR requires Razorpay account-manager enablement.
VITE_CUSTOM_CHECKOUT_EMBEDDED_QR=false
